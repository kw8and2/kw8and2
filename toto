<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>حاسبة بصمة التواجد</title>

<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;700;900&display=swap" rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Cairo',sans-serif;
}

body{
    background:#f4f6f9;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
    padding:20px;
}

.container{
    width:100%;
    max-width:700px;
    background:#fff;
    border-radius:25px;
    padding:35px;
    box-shadow:0 15px 35px rgba(0,0,0,.15);
}

h1{
    text-align:center;
    color:#0d6efd;
    font-size:42px;
    margin-bottom:35px;
    font-weight:900;
}

.inputs{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:15px;
    margin-bottom:35px;
    flex-wrap:wrap;
}

input{
    width:120px;
    height:90px;
    font-size:42px;
    text-align:center;
    border:3px solid #0d6efd;
    border-radius:18px;
    outline:none;
    font-weight:bold;
}

#period{
    width:120px;
    height:90px;
    font-size:30px;
    text-align:center;
    border:3px solid #0d6efd;
    border-radius:18px;
    outline:none;
    font-weight:bold;
    cursor:pointer;
}

.colon{
    font-size:50px;
    font-weight:bold;
}

button{
    width:100%;
    height:85px;
    border:none;
    border-radius:18px;
    background:#0d6efd;
    color:#fff;
    font-size:34px;
    font-weight:bold;
    cursor:pointer;
    transition:.3s;
}

button:hover{
    background:#0b5ed7;
}

.result{
    margin-top:35px;
}

.card{
    background:#f8f9fa;
    border:2px solid #dee2e6;
    border-radius:20px;
    padding:25px;
    margin-bottom:20px;
    text-align:center;
}

.card h2{
    font-size:30px;
    color:#444;
    margin-bottom:15px;
}

.time{
    font-size:55px;
    color:#198754;
    font-weight:900;
}

.reset{
    margin-top:15px;
    background:#dc3545;
}

.reset:hover{
    background:#bb2d3b;
}

.footer{
    margin-top:25px;
    text-align:center;
    color:#666;
    font-size:18px;
    line-height:1.8;
}

@media(max-width:600px){

h1{
    font-size:34px;
}

input,#period{
    width:95px;
    height:75px;
    font-size:30px;
}

button{
    font-size:28px;
}

.time{
    font-size:42px;
}

.card h2{
    font-size:24px;
}

}

</style>
</head>

<body>

<div class="container">

<h1>حاسبة بصمة التواجد</h1>

<div class="inputs">

<input
type="number"
id="hour"
placeholder="الساعة"
min="1"
max="12">

<div class="colon">:</div>

<input
type="number"
id="minute"
placeholder="الدقيقة"
min="0"
max="59">

<select id="period">
<option value="AM">AM</option>
<option value="PM">PM</option>
</select>

</div>

<button onclick="calculate()">احسب</button>

<div class="result">

<div class="card">
<h2>بداية بصمة التواجد</h2>
<div class="time" id="start">--:--</div>
</div>

<div class="card">
<h2>نهاية بصمة التواجد</h2>
<div class="time" id="end">--:--</div>
</div>

</div>

<button class="reset" onclick="resetForm()">مسح</button>

<div class="footer">
بداية بصمة التواجد = وقت الحضور + ساعتين + دقيقة واحدة<br>
نهاية بصمة التواجد = وقت الحضور + ثلاث ساعات
</div>

</div>

<script>

function formatTime(totalMinutes){

    totalMinutes=(totalMinutes+1440)%1440;

    let h=Math.floor(totalMinutes/60);
    let m=totalMinutes%60;

    let period=(h>=12)?"PM":"AM";

    let displayHour=h%12;

    if(displayHour===0)
        displayHour=12;

    return displayHour + ":" +
           String(m).padStart(2,'0') +
           " " + period;

}

function calculate(){

    let h=parseInt(document.getElementById("hour").value);
    let m=parseInt(document.getElementById("minute").value);
    let period=document.getElementById("period").value;

    if(
        isNaN(h)||
        isNaN(m)||
        h<1||
        h>12||
        m<0||
        m>59
    ){
        alert("يرجى إدخال وقت صحيح");
        return;
    }

    // تحويل إلى 24 ساعة

    if(period==="AM"){

        if(h===12)
            h=0;

    }else{

        if(h!==12)
            h+=12;

    }

    let total=h*60+m;

    let start=total+121;
    let end=total+180;

    document.getElementById("start").innerHTML=formatTime(start);
    document.getElementById("end").innerHTML=formatTime(end);

}

function resetForm(){

    document.getElementById("hour").value="";
    document.getElementById("minute").value="";
    document.getElementById("period").value="AM";

    document.getElementById("start").innerHTML="--:--";
    document.getElementById("end").innerHTML="--:--";

}

document.addEventListener("keypress",function(e){

    if(e.key==="Enter"){
        calculate();
    }

});

</script>

</body>
</html>
