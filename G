# Add reminder behavior before reset listener
marker = 'resetBtn.addEventListener("click", () => {'
reminder_js = r'''
const reminderTimes = [
  "9:00 ص",
  "12:00 م",
  "3:00 م",
  "6:00 م",
  "8:15 م"
];

function buildReminderText(){
  return meals.map((m, i) =>
    `${reminderTimes[i]} — ${m.title}: ${picks[m.key] || ""}`
  ).join("\n");
}

function showReminderSetup(){
  const complete = meals.every(m => picks[m.key]);
  if(!complete){
    alert("أكمل اختيار الخمس وجبات أولًا.");
    return;
  }

  reminderPreview.innerHTML = "";
  meals.forEach((m, i) => {
    const row = document.createElement("div");
    row.className = "reminder-row";
    row.innerHTML = `<b>${reminderTimes[i]} — ${m.title}</b><br>${picks[m.key]}`;
    reminderPreview.appendChild(row);
  });
  reminderPanel.classList.add("show");
  reminderPanel.scrollIntoView({behavior:"smooth", block:"start"});
}

remindersBtn.addEventListener("click", showReminderSetup);

copyRemindersBtn.addEventListener("click", async () => {
  const text = buildReminderText();
  try{
    await navigator.clipboard.writeText(text);
    copyRemindersBtn.textContent = "تم النسخ ✓";
    setTimeout(()=> copyRemindersBtn.textContent = "نسخ التنبيهات", 1800);
  }catch(e){
    const ta = document.createElement("textarea");
    ta.value = text;
    document.body.appendChild(ta);
    ta.select();
    document.execCommand("copy");
    document.body.removeChild(ta);
    copyRemindersBtn.textContent = "تم النسخ ✓";
    setTimeout(()=> copyRemindersBtn.textContent = "نسخ التنبيهات", 1800);
  }
});

openShortcutsBtn.addEventListener("click", () => {
  window.location.href = "shortcuts://";
});

'''
html = html.replace(marker, reminder_js + marker)

