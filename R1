<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>جدول 5 وجبات</title>
<style>
:root{
  --bg:#f7f7f7;
  --card:#fff;
  --text:#111;
  --muted:#6b6b6b;
  --line:#ddd;
  --danger:#c1121f;
  --dangerBg:#fff5f5;
}
*{box-sizing:border-box}
body{
  margin:0;
  background:var(--bg);
  color:var(--text);
  font-family:Tahoma,Arial,"Segoe UI",sans-serif;
}
.wrap{
  max-width:680px;
  margin:auto;
  padding:12px 9px 36px;
}
h1{
  margin:0 0 5px;
  font-size:23px;
  font-weight:800;
}
.sub{
  font-size:14px;
  color:var(--muted);
  line-height:1.6;
  margin-bottom:9px;
}
.step{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:10px;
  padding:10px;
}
.step-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
  margin-bottom:8px;
}
.step-title{
  font-size:17px;
  font-weight:800;
}
.time{
  font-size:13px;
  color:var(--muted);
  background:#f1f1f1;
  padding:4px 7px;
  border-radius:7px;
  white-space:nowrap;
}
.options{
  display:grid;
  gap:5px;
}
.option{
  width:100%;
  text-align:right;
  border:1px solid var(--line);
  background:#fff;
  color:#111;
  padding:11px 10px;
  border-radius:8px;
  font-size:15px;
  line-height:1.55;
  font-weight:600;
  cursor:pointer;
}
.option:hover{background:#fafafa}
.final{
  display:none;
}
.final.show{display:block}
.final-title{
  font-size:21px;
  font-weight:800;
  margin-bottom:7px;
}
.final-list{
  display:grid;
  gap:5px;
}
.final-card{
  background:#fff;
  border:1px solid var(--line);
  border-radius:9px;
  padding:10px;
}
.final-head{
  display:flex;
  justify-content:space-between;
  gap:8px;
  margin-bottom:5px;
}
.final-name{
  font-size:15px;
  font-weight:800;
}
.final-time{
  color:var(--muted);
  font-size:12px;
}
.final-text{
  font-size:15px;
  line-height:1.6;
  font-weight:600;
}
.notes{
  margin-top:9px;
  background:var(--dangerBg);
  border:1px solid #efb1b6;
  color:var(--danger);
  border-radius:9px;
  padding:10px;
  font-size:14px;
  line-height:1.85;
  font-weight:700;
}
.notes-title{
  font-size:16px;
  font-weight:900;
  margin-bottom:3px;
}
.actions{
  margin-top:9px;
  display:flex;
  gap:7px;
  flex-wrap:wrap;
}
.calendar-btn{
  border:0;
  background:#0f766e;
  color:#fff;
  padding:9px 12px;
  border-radius:8px;
  font-weight:700;
  font-size:14px;
  cursor:pointer;
}
.calendar-btn:hover{background:#0b5f59}

.reset{
  border:0;
  background:#111;
  color:#fff;
  padding:9px 12px;
  border-radius:8px;
  font-weight:700;
  font-size:14px;
  cursor:pointer;
}
@media(max-width:560px){
  .wrap{padding:9px 7px 28px}
  h1{font-size:21px}
  .step-title{font-size:16px}
  .option{font-size:15px}
}
</style>
</head>
<body>
<div class="wrap">
  <h1>اختَر جدولك اليومي — 5 وجبات</h1>
  <div class="sub">كل مرة اختر خيارًا واحدًا فقط. بعد الاختيار يختفي ويظهر لك مباشرة القسم التالي.</div>

  <div id="stepArea"></div>

  <div id="final" class="final">
    <div class="final-title">جدولك اليومي النهائي ✓</div>
    <div id="finalList" class="final-list"></div>

    <div class="notes">
      <div class="notes-title">ملاحظات مهمة</div>
      <div>• مع مونجارو: لا تجبر نفسك على إكمال الوجبة إذا شبعت.</div>
      <div>• تجنب الوجبات الدسمة جدًا والمقليات، خصوصًا في المساء.</div>
      <div>• في الكويت اختر الزبادي السادة/قليل الدسم، التونة بالماء أو المحلول الملحي، والخبز كامل القمح بدل الأنواع المحلاة أو المقلية.</div>
      <div>• قلل السكريات والعصائر والمشروبات المحلاة.</div>
      <div>• لا تعمل صيامًا طويلًا جدًا ثم تتناول وجبة كبيرة وثقيلة.</div>
      <div>• العشاء الأفضل يكون خفيفًا وينتهي قبل الساعة 9 مساءً.</div>
      <div>• الماء: بوزن 86 كغ، هدف مناسب لك تقريبًا 2.6–3.0 لتر سوائل يوميًا، وخلك قريب من 3 لتر. مع حر الكويت أو الرياضة قد تحتاج أكثر قليلًا. إذا عندك تقييد سوائل من طبيب أو مشاكل بالكلى/القلب فاتبع تعليمات طبيبك.</div>
      <div>• إذا ظهر ألم شديد ومستمر بالبطن أو قيء متكرر، اطلب تقييمًا طبيًا.</div>
    </div>

    <div class="actions">
      <button id="calendarBtn" class="calendar-btn">📅 أضف مباشرة إلى تقويم الآيفون</button>
      <button id="resetBtn" class="reset">ابدأ من جديد</button>
    </div>
  </div>
</div>

<script>
const meals = [
  {
    key:"breakfast", title:"الفطور", time:"9:00 صباحًا",
    options:[
      "2 بيض مسلوق + شريحة توست أسمر + خيار وطماطم",
      "أومليت 2 بيض بالخضار + شريحة توست أسمر",
      "زبادي يوناني نادا قليل الدسم 160 غ أو KDCOW خالي الدسم 170 غ + كويكر شوفان 30 غ + فراولة",
      "2 بيض + نصف خبزة عربية أسمر + خضار",
      "جبن قريش 100–120 غ + توست KFM كامل القمح + خيار",
      "فول ½–¾ كوب + نصف خبزة أسمر + خضار",
      "كويكر شوفان كامل 40 غ + حليب المراعي قليل الدسم 150–200 مل + قرفة",
      "ساندويتش تونة John West بالماء أو LuLu بالمحلول الملحي 80–100 غ + توست KFM كامل القمح + خس",
      "لبنة قليلة الدسم 3 ملاعق كبيرة + خبز أسمر صغير + خيار",
      "2 بيض + بطاطا مسلوقة صغيرة + سلطة خفيفة"
    ]
  },
  {
    key:"snack1", title:"السناك الأول", time:"12:00 ظهرًا",
    options:[
      "زبادي يوناني نادا قليل الدسم 160 غ أو KDCOW خالي الدسم 170 غ",
      "تفاحة صغيرة + 5–7 حبات لوز",
      "برتقالة + قطعة جبن قليل الدسم",
      "بيضة مسلوقة + خيار",
      "كمثرى صغيرة + 5 حبات لوز أو جوز",
      "زبادي المراعي قليل الدسم 150–170 غ",
      "لبن/حليب قليل الدسم من المراعي أو KDD حجم 150–200 مل",
      "نصف موزة + زبادي صغير غير محلى",
      "خيار وجزر + ملعقتان لبنة قليلة الدسم",
      "جبن قريش 80–100 غ + خيار"
    ]
  },
  {
    key:"lunch", title:"الغداء", time:"3:00 عصرًا",
    options:[
      "دجاج مشوي 150–180 غ + نصف كوب رز بسمتي + سلطة",
      "سمك مشوي 150–180 غ + بطاطا صغيرة/متوسطة + خضار",
      "لحم بقري قليل الدهن 120–150 غ + نصف كوب رز + سلطة",
      "دجاج بالفرن 150–180 غ + نصف خبزة أسمر + سلطة",
      "كباب مشوي قليل الدهن 150 غ + نصف كوب رز + خضار",
      "روبيان مشوي 150–180 غ + نصف كوب رز + سلطة",
      "لحم مفروم قليل الدهن 150 غ + بطاطا مشوية صغيرة + سلطة",
      "سمك 180 غ + نصف كوب رز بسمتي + بروكلي/كوسا",
      "دجاج 170 غ + برغل ½–¾ كوب + سلطة",
      "تونة John West بالماء أو LuLu بالمحلول الملحي 150 غ مصفاة + بطاطا مسلوقة صغيرة + سلطة كبيرة"
    ]
  },
  {
    key:"snack2", title:"السناك الثاني", time:"6:00 مساءً",
    options:[
      "تفاحة صغيرة + قطعة جبن خفيف",
      "برتقالة + زبادي غير محلى",
      "كمثرى + 5–7 حبات لوز",
      "نصف موزة + زبادي يوناني صغير",
      "زبادي بروتين المراعي قليل الدسم 150 غ + قرفة",
      "بيضة مسلوقة + خيار وطماطم",
      "لبن/حليب قليل الدسم من المراعي أو KDD حجم 150–200 مل",
      "حبتان تمر + 5 حبات لوز",
      "فراولة 100–150 غ + زبادي يوناني",
      "جبن قريش 80–100 غ + خيار"
    ]
  },
  {
    key:"dinner", title:"العشاء", time:"8:00–8:30 مساءً",
    options:[
      "دجاج مشوي 120–150 غ + سلطة",
      "سمك مشوي 150 غ + خضار مطبوخة",
      "تونة John West بالماء أو LuLu بالمحلول الملحي 100–150 غ + سلطة",
      "2 بيض + 1–2 بياض بيض + خضار",
      "جبن قريش 120–150 غ + خيار وطماطم",
      "دجاج 120 غ + نصف خبزة أسمر + خضار",
      "لحم قليل الدهن 120 غ + سلطة كبيرة",
      "أومليت 2 بيض + خضار + شريحة توست أسمر",
      "روبيان مشوي 150 غ + خضار",
      "زبادي نادا اليوناني قليل الدسم 160 غ أو KDCOW خالي الدسم 170 غ + خيار + نصف خبزة أسمر صغيرة"
    ]
  }
];

let picks = {};
try{
  picks = JSON.parse(localStorage.getItem("mealPicksV5") || "{}");
}catch(e){
  picks = {};
}

const stepArea = document.getElementById("stepArea");
const finalBox = document.getElementById("final");
const finalList = document.getElementById("finalList");
const resetBtn = document.getElementById("resetBtn");
const calendarBtn = document.getElementById("calendarBtn");

function save(){
  localStorage.setItem("mealPicksV5", JSON.stringify(picks));
}

function render(){
  stepArea.innerHTML = "";
  finalList.innerHTML = "";
  finalBox.classList.remove("show");

  const currentIndex = meals.findIndex(m => !picks[m.key]);

  if(currentIndex === -1){
    meals.forEach(m => {
      const card = document.createElement("div");
      card.className = "final-card";
      card.innerHTML = `
        <div class="final-head">
          <div class="final-name">${m.title}</div>
          <div class="final-time">${m.time}</div>
        </div>
        <div class="final-text">${picks[m.key]}</div>
      `;
      finalList.appendChild(card);
    });
    finalBox.classList.add("show");
    return;
  }

  const meal = meals[currentIndex];
  const section = document.createElement("section");
  section.className = "step";

  const head = document.createElement("div");
  head.className = "step-head";
  head.innerHTML = `
    <div class="step-title">${currentIndex + 1}. ${meal.title}</div>
    <div class="time">${meal.time}</div>
  `;
  section.appendChild(head);

  const options = document.createElement("div");
  options.className = "options";

  meal.options.forEach(optionText => {
    const btn = document.createElement("button");
    btn.type = "button";
    btn.className = "option";
    btn.textContent = optionText;
    btn.addEventListener("click", () => {
      picks[meal.key] = optionText;
      save();
      render();
      window.scrollTo({top:0, behavior:"smooth"});
    });
    options.appendChild(btn);
  });

  section.appendChild(options);
  stepArea.appendChild(section);
}


function pad2(n){
  return String(n).padStart(2,"0");
}

function icsEscape(text){
  return String(text || "")
    .replace(/\\/g, "\\\\")
    .replace(/\n/g, "\\n")
    .replace(/,/g, "\\,")
    .replace(/;/g, "\\;");
}

function localDateTime(date, hour, minute){
  return (
    date.getFullYear() +
    pad2(date.getMonth()+1) +
    pad2(date.getDate()) +
    "T" +
    pad2(hour) +
    pad2(minute) +
    "00"
  );
}

function openIPhoneCalendar(){
  const complete = meals.every(m => picks[m.key]);
  if(!complete){
    alert("أكمل اختيار الخمس وجبات أولًا.");
    return;
  }

  if(location.protocol === "file:"){
    alert("ميزة الإضافة المباشرة تعمل بعد رفع الصفحة وملف التقويم على الموقع.");
    return;
  }

  const icsUrl = location.origin + "/meal-plan-kuwait.ics";
  const webcalUrl = icsUrl.replace(/^https?:\/\//, "webcal://");
  window.location.href = webcalUrl;
}

calendarBtn.addEventListener("click", openIPhoneCalendar);

resetBtn.addEventListener("click", () => {
  picks = {};
  localStorage.removeItem("mealPicksV5");
  render();
  window.scrollTo({top:0, behavior:"smooth"});
});

render();
</script>
</body>
</html>
